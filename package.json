{
	"name": "songphang",
	"private": true,
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=24.7.0"
	},
	"scripts": {
		"dev": "docker compose up -d --wait db && pnpm db:migrate && pnpm db:seed && pnpm -r --parallel dev",
		"build": "pnpm -r --if-present build",
		"check": "biome check . && pnpm -r typecheck && pnpm contract:check",
		"contract:write": "pnpm --filter @songphang/api contract:write",
		"contract:check": "pnpm --filter @songphang/api contract:check",
		"typecheck": "pnpm -r typecheck",
		"db:migrate": "pnpm --filter @songphang/db migrate",
		"db:seed": "pnpm --filter @songphang/db seed",
		"db:check-balances": "pnpm --filter @songphang/db check-balances"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"typescript": "7.0.2"
	}
}
