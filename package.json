{
	"name": "songphang",
	"private": true,
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check . && pnpm -r typecheck",
		"typecheck": "pnpm -r typecheck",
		"db:migrate": "pnpm --filter @songphang/db migrate",
		"db:seed": "pnpm --filter @songphang/db seed"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"typescript": "7.0.2"
	}
}
